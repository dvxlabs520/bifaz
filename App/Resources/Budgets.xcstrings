{
  "sourceLanguage" : "en",
  "strings" : {
    "budget.alert.near.announcement %@" : {
      "extractionState" : "manual",
      "comment" : "VoiceOver announcement after a save pushes a budget past 80 %. Argument: category name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budget %@ is close to its limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El presupuesto %@ está cerca del límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le budget %@ approche de sa limite."
          }
        }
      }
    },
