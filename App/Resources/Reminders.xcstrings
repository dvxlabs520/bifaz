{
  "sourceLanguage" : "en",
  "strings" : {
    "reminders.budget.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you add an expense yourself, the in-app alert is enough."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando añades un gasto tú mismo, basta con el aviso dentro de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous ajoutez vous-même une dépense, l’alerte dans l’app suffit."
          }
        }
      }
    },
    "reminders.budget.toggle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budget exceeded by an automatic expense"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presupuesto superado por un gasto automático"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budget dépassé par une dépense automatique"
          }
        }
      }
    },
    "reminders.denied.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To receive reminders, allow notifications for Bifaz in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para recibir recordatorios, permite las notificaciones de Bifaz en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour recevoir des rappels, autorisez les notifications de Bifaz dans Réglages."
          }
        }
      }
    },
    "reminders.denied.button" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir Ajustes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir les Réglages"
          }
        }
      }
    },
    "reminders.denied.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are turned off"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones están desactivadas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont désactivées"
          }
        }
      }
    },
    "reminders.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are local: they are scheduled on your iPhone and nothing is sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones son locales: se programan en tu iPhone y no se envía nada a ningún sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont locales : elles sont programmées sur votre iPhone et rien n’est envoyé nulle part."
          }
        }
      }
    },
    "reminders.recurring.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bifaz cannot add the expense in the background. It reminds you, and adds it when you open the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bifaz no puede añadir el gasto en segundo plano. Te lo recuerda y lo añade cuando abres la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bifaz ne peut pas ajouter la dépense en arrière-plan. Il vous le rappelle et l’ajoute quand vous ouvrez l’app."
          }
        }
      }
    },
    "reminders.recurring.toggle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
