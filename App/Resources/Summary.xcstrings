    "summary.change.down %@ %@ %@" : {
      "extractionState" : "manual",
      "comment" : "Month comparison, spending went down. 1: amount, 2: previous month name, 3: signed percentage.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ less than in %2$@ (%3$@)"
