    "settings.rates.caption" : {
      "extractionState" : "manual",
      "comment" : "Settings caption under the ECB toggle.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only when you enter an amount in a foreign currency, at most once a day, from the European Central Bank’s public tables. Nothing about you or your expenses is sent. Turned off, Bifaz never uses the network: you enter the rate or the euro amount yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cuando indica un importe en moneda extranjera, como mucho una vez al día, desde las tablas públicas del Banco Central Europeo. No se envía nada sobre usted ni sus gastos. Desactivado, Bifaz nunca usa la red: indica usted el tipo o el importe en euros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement quand vous saisissez un montant en devise étrangère, au plus une fois par jour, depuis les tables publiques de la Banque centrale européenne. Rien sur vous ni sur vos dépenses n’est envoyé. Désactivé, Bifaz n’utilise jamais le réseau : vous saisissez le taux ou le montant en euros vous-même."
          }
        }
      }
    },
    "settings.rates.toggle" : {
