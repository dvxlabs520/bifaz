      "comment" : "Caption under the VAT toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn this off if you are a micro-entrepreneur under the “franchise en base de TVA”. VAT fields are then hidden when you add expenses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactívalo si eres micro-emprendedor en “franchise en base de TVA”. Los campos de TVA se ocultarán al añadir gastos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez cette option si vous êtes micro-entrepreneur en franchise en base de TVA. Les champs de TVA seront alors masqués lors de la saisie des dépenses."
          }
        }
      }
