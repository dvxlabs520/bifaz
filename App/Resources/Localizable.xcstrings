    "summary.empty.message" : {
      "comment" : "Message of the welcome empty state on the Summary tab. '+' is the capture button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap + to scan a receipt or jot down an expense. Pro and Personal stay separate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca + para escanear una factura o apuntar un gasto. Pro y Personal siempre van por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche + pour scanner une facture ou noter une dépense. Pro et Perso restent séparés."
          }
        }
      }
    },
