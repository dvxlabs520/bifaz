    "storeError.message" : {
      "comment" : "Message shown when the local database cannot be opened.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data is safe on this iPhone. Restart Bifaz; if it keeps happening, update the app."
