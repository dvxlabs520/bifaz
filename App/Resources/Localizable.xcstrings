    "assistant.empty.message" : {
      "comment" : "Message of the empty state on the Assistant tab.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soon you’ll ask questions in plain words, and answers are computed on your iPhone, without sending your data anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronto podrás preguntar con tus propias palabras. Las respuestas se calculan en tu iPhone, sin enviar tus datos a ningún sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bientôt, vous pourrez poser vos questions avec vos mots. Les réponses sont calculées sur votre iPhone, sans envoyer vos données nulle part."
          }
        }
      }
    },
    "assistant.empty.title" : {
      "comment" : "Title of the empty state on the Assistant tab.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask about your spending"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta por tus gastos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez vos questions sur vos dépenses"
          }
        }
      }
    },
    "assistant.example.biggest" : {
      "comment" : "Example question for the Assistant, shown without quotation marks.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What was my biggest Pro expense this year?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuál fue mi mayor gasto Pro este año?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle a été ma plus grosse dépense pro cette année ?"
          }
        }
      }
    },
    "assistant.example.restaurants" : {
      "comment" : "Example question for the Assistant, shown without quotation marks.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much did I spend on restaurants in October?"
