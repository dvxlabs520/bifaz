    "storeError.message" : {
      "comment" : "Message shown when the local database cannot be opened.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data is safe on this iPhone. Restart Bifaz; if it keeps happening, update the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos están a salvo en este iPhone. Reinicia Bifaz; si sigue pasando, actualiza la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes données sont en sécurité sur cet iPhone. Redémarre Bifaz ; si le problème persiste, mets l’app à jour."
          }
        }
      }
    },
    "storeError.title" : {
      "comment" : "Title shown when the local database cannot be opened.",
