{
  "sourceLanguage" : "en",
  "strings" : {
    "assistant.empty.message" : {
      "comment" : "Message of the empty state on the Assistant tab; includes an example question in quotes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soon you’ll be able to ask in plain words, like “How much did I spend on restaurants in October?” Answers are computed on your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronto podrás preguntar con tus propias palabras, por ejemplo «¿Cuánto gasté en restaurantes en octubre?». Las respuestas se calculan en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bientôt, tu pourras poser tes questions avec tes mots, par exemple « Combien ai-je dépensé au restaurant en octobre ? ». Les réponses sont calculées sur ton iPhone."
          }
        }
      }
    },
    "assistant.empty.title" : {
      "comment" : "Title of the empty state on the Assistant tab.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask about your spending"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta por tus gastos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose tes questions sur tes dépenses"
          }
        }
      }
    },
    "capture.hint" : {
      "comment" : "VoiceOver hint of the floating + capture button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan a receipt or add an expense."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea una factura o añade un gasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne une facture ou ajoute une dépense."
          }
        }
      }
    },
