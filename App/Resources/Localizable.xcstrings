          }
        }
      }
    },
    "expenses.empty.message" : {
      "comment" : "Message of the empty state on the Expenses tab.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything you capture shows up here, month by month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que captures aparecerá aquí, mes a mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que tu ajoutes apparaît ici, mois par mois."
          }
        }
      }
    },
