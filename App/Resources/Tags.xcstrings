    "tags.screen.delete.message" : {
      "extractionState" : "manual",
      "comment" : "Confirmation message.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your expenses are kept, not deleted; they only lose this tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus gastos se conservan, no se eliminan; solo pierden esta etiqueta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos dépenses sont conservées, pas supprimées ; elles perdent seulement cette étiquette."
          }
        }
      }
    },
