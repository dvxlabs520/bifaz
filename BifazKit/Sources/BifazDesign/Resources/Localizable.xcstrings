    "sentence.template" : {
      "extractionState" : "manual",
      "comment" : "Entry sentence of a new expense. Keep the slots in braces, in any order: {amount}, {merchant}, {category}, {space}, {date}. Each slot becomes a tappable piece. Write a natural sentence for the language, not a word-for-word translation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I spent {amount} at {merchant} on {category} · {space} · {date}"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gasté {amount} en {merchant} para {category} · {space} · {date}"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai dépensé {amount} chez {merchant}, en {category} · {space} · {date}"
          }
        }
      }
    },
